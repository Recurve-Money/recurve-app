# RPC for Robinhood Chain. Falls back to the public endpoint when unset.
VITE_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# WalletConnect project id. Without it only injected wallets (MetaMask) work.
VITE_WALLETCONNECT_ID=

# Deployed addresses, from script/Deploy.s.sol output
VITE_REGISTRY=
VITE_REVE=
VITE_DEPLOY_BLOCK=
